# ============================================================
#  Налаштування ВКСК. Скопіюй у .env — він НЕ комітиться
#  (див. .gitignore). Встав ключ після знака "=" без лапок
#  і без пробілів.
# ============================================================

# Безкоштовний ключ Groq: https://console.groq.com  ->  API Keys
# Виглядає як gsk_...
# Використовується в прогонах FinQA (модель openai/gpt-oss-120b).
GROQ_API_KEY=

# Безкоштовний ключ Google AI Studio: https://aistudio.google.com/apikey
# Використовується в прогонах DataBench (модель gemini-flash-lite-latest).
# Квота окрема від Groq, тож два провайдери не конкурують за бюджет.
GEMINI_API_KEY=

# --- решта має робочі дефолти, розкоментовуй лише за потреби ---

# groq (дефолт) | gemini | mock (примусово без мережі)
# Без ключа вибраного провайдера автоматично стає mock.
# VKSK_LLM_PROVIDER=groq

# Дефолт для groq: openai/gpt-oss-120b
# Дефолт для gemini: gemini-flash-lite-latest
# УВАГА: сімейство llama-3.x з безкоштовного тарифу Groq ЗНЯТО (404).
# НЕ бери qwen/qwen3.6-27b — друкує <think>-блок, псує розбір мітки.
# VKSK_LLM_MODEL=openai/gpt-oss-120b

# Мовний профіль: en (дефолт) | uk
# Заморожена регресія Фази 0 вимагає явного uk.
# VKSK_LANG=en

# Шлях до журналу токенів. Без цієї змінної витрати НЕ обліковуються
# (дефект 23), тому для будь-якого реального прогону задавай її.
# VKSK_TOKEN_LEDGER=eval/finqa_cache/token_ledger.jsonl

# Увімкнути sentence-transformers у векторному індексі (потребує ~2 ГБ torch).
# За замовчуванням вимкнено: на цих даних TF-IDF точніший (RESULTS.md).
# VKSK_USE_EMBEDDINGS=1
