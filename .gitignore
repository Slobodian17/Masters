# Secrets
.env

# Documents. The repository carries exactly two: what the numbers are, and how
# to reproduce them. Working notes and drafts stay local.
*.md
!README.md
!RESULTS.md
docs/
review/

# Editor and tooling configuration, not part of the work
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Datasets. FinQA, TAT-DQA and DataBench are fetched or unpacked by the loader
# scripts (README section 3); 636 MB of them does not belong in git. The
# hand-built query-type training sets do, because nothing regenerates them.
data/*
!data/query_type_dataset.json
!data/query_type_dataset_en.json
!data/query_type_disagreements.json

# Trained models and run artifacts, all regenerated by the scripts
*.joblib
eval_results.csv
eval_results_*.csv
eval/eval_phase1_results*.csv
eval/zero_shot_classifier_results*.csv
eval/scope_gate_results*.csv
eval/query_classifier_results*.csv
sample_report*.pdf

# Run logs: stdout of long passes, superseded by the caches they wrote
eval/*.log
